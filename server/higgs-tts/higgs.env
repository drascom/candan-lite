# /opt/higgs-tts/higgs.env — higgs-tts.service ortamı
# NOT: systemd EnvironmentFile ayrıştırıcısı boşluklu değerleri tırnaksız sever;
# uzun REF_TEXT bilerek tırnaksız tek satırda (bkz. worker/go.sh üst yorumu).
HF_HOME=/opt/higgs-models/hf
HIGGS_MODEL=multimodalart/higgs-audio-v3-tts-4b-transformers
HIGGS_REF_AUDIO=/opt/omnivoice/default-ref.wav
HIGGS_REF_TEXT=Merhaba, bu bir Türkçe seslendirme testidir. VoxCPM 2 ile uzun kitapları sesli kitaba dönüştürebilirsiniz.
HIGGS_REF_CODES=/opt/higgs-tts/refs/default-ref.codes.pt
HIGGS_HOST=0.0.0.0
HIGGS_PORT=8809
HIGGS_TEMPERATURE=0.8
HIGGS_TOP_K=50
HIGGS_MAX_NEW_TOKENS=2048
HIGGS_MAX_CHARS=400
