worker/models/
worker/data/
*.onnx

# HAFIZA — kişisel/aile verisi PUBLIC repo'ya ASLA girmez.
# Audit için memory/ içinde ayrı, push edilmeyen nested git var.
# Kök-çapalı: yalnız üst-düzey memory/ (pi/skills/memory/ gibi kod dizinlerini değil).
/memory/

# sunucudan çekilen yedekler — speakers.db + aile ses kayıtları, PUBLIC repo'ya ASLA girmez.
.server-backups/

# ham ses varlıkları — aile ses kayıtları (*.opus), PUBLIC repo'ya ASLA girmez.
/asset/

# Candan'ın referans sesi (ses kimliği). Dosyanın KENDİSİ girmez — depo PUBLIC ve
# yukarıdaki iki kural da referans wav'ını "biyometrik veri" sayıyor; public geçmişe
# yazmak GERİ ALINAMAZ. README.md (md5, köken, geri getirme) commit EDİLİR.
# Kullanıcı aksini isterse: git add -f assets/voice/default-ref.wav
/assets/voice/*.wav
/assets/voice/*.pt

# testler: kullanıcı kararı — ne git'te ne sunucuda dursun.
worker/tests/

# os / editor
.DS_Store
*.log
.vscode/
.idea/

# tts-local-bench (experiments/): üretilen ses, model ağırlıkları ve venv'ler.
# Bench ARAÇLARI (runners/, sentences.json, compare.html, README) commit edilir;
# çıktılar ve GB'larca ağırlık EDİLMEZ.
experiments/tts-local-bench/out/
experiments/tts-local-bench/venvs/
experiments/tts-local-bench/vendor/
experiments/tts-local-bench/refs/*.wav
# referans sesten türetilen ses-klon prompt tensörleri — *.wav gibi biyometrik veri, girmez.
experiments/tts-local-bench/refs/*.pt

# higgs-tts3 (experiments/): aynı kural. Araçlar (run_*.py, compare.html, README,
# sentences.json) commit edilir; sunucudan çekilen ses ve referans türevleri EDİLMEZ.
experiments/higgs-tts3/out/
experiments/higgs-tts3/refs/*.wav
experiments/higgs-tts3/refs/*.pt
